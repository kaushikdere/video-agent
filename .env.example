# ─── LLM Provider Keys ────────────────────────────────────────────────────────
# At least one is required. LiteLLM resolves model aliases from these.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── Video Generation Provider ────────────────────────────────────────────────
# Leave blank to use the mock provider (coloured placeholder clips)
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai/v1

# ─── LiteLLM Proxy ────────────────────────────────────────────────────────────
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master

# ─── Langfuse Observability ───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://video_agent:secret@localhost:5432/video_agent

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage (S3 / MinIO) ─────────────────────────────────────────────────────
STORAGE_BACKEND=local          # "local" | "s3"
LOCAL_STORAGE_PATH=./artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=video-agent-artifacts
S3_ENDPOINT_URL=http://localhost:9000   # MinIO endpoint for local dev

# ─── Agent Behaviour ──────────────────────────────────────────────────────────
MAX_QC_REPAIR_ATTEMPTS=2
MAX_JOB_BUDGET_USD=2.00
MAX_JOB_ITERATIONS=20
MAX_JOB_WALL_CLOCK_SECONDS=480

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
API_SECRET_KEY=change-me-in-production
